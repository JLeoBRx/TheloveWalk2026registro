# FJ Night — A Noite da Herança · configuração do servidor
# Copie para .env (na pasta fjnight/) e ajuste. Nunca faça commit do .env.

# Token do painel /admin (mínimo 24 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
ADMIN_TOKEN=troque-por-um-token-aleatorio-longo

# Chave que cifra os vetores faciais (AES-256-GCM). Use um valor longo e aleatório.
# Se ficar vazia, uma chave é gerada em data/biometria/.chave.
FACE_DATA_KEY=

# Pastas (relativas a fjnight/ ou absolutas)
PHOTO_DIR=./fotos
DATA_DIR=./data

# Fotos: download liberado por padrão? (exceções em config/photo-rules.json ou no painel)
DOWNLOADS_DEFAULT=true

# Reconhecimento facial
FACE_SEARCH_ENABLED=true
# Similaridade mínima (cosseno SFace). Calibrado em 0.40; aumente para menos resultados.
FACE_MATCH_THRESHOLD=0.40
# Dias, contados a partir da data do evento (config/event.json), até apagar os dados faciais.
FACE_DATA_RETENTION_DAYS=90
# Alternativa: data exata de expiração (ISO 8601), ex.: 2027-02-11T00:00:00+00:00
FACE_DATA_EXPIRES_AT=
# Limite de buscas por endereço de origem
FACE_SEARCH_RATE_LIMIT=10
FACE_SEARCH_RATE_WINDOW_SECONDS=600
MAX_UPLOAD_MB=12

# Indexa automaticamente ao iniciar quando o build não gerou o índice.
INDEX_ON_STARTUP=true

# Só necessário se outro domínio consumir a API (o site é servido pelo próprio servidor).
CORS_ORIGINS=
