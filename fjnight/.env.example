# FJU Night — A Noite da Herança · configuração do servidor
# Copie para .env (na pasta fjnight/). Nunca faça commit do .env.

APP_ENV=development

# Senha do painel /admin (mínimo 24 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
ADMIN_TOKEN=troque-por-um-token-aleatorio-longo

# Banco durável. Vazio = SQLite em data/ (apenas desenvolvimento).
# Produção: PostgreSQL, ex.: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=
# Só declare true se o SQLite estiver num disco persistente.
SQLITE_ON_PERSISTENT_DISK=false

# Fotos no Cloudflare R2 (deixe R2_BUCKET vazio para usar a pasta fotos/).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ORIGINALS_PREFIX=originais/
R2_DERIVATIVES_PREFIX=derivados/

# Busca facial: desligada por padrão. Ligar aqui NÃO basta: é preciso preencher
# config/privacy.json e registrar a autorização no painel.
FACE_SEARCH_ENABLED=false
# Chave da cifragem facial. Gere uma vez e nunca altere depois de registrar oposições.
FACE_DATA_KEY=
FACE_DATA_RETENTION_DAYS=90
FACE_MATCH_THRESHOLD=0.40
FACE_SEARCH_RATE_LIMIT=10
FACE_SEARCH_RATE_WINDOW_SECONDS=600
MAX_UPLOAD_MB=12

# Proxy: número de proxies confiáveis à frente da aplicação (Render = 1),
# ou um cabeçalho que a borda sempre sobrescreve (ex.: cf-connecting-ip).
TRUSTED_PROXY_HOPS=0
CLIENT_IP_HEADER=

ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8

DOWNLOADS_DEFAULT=true
RAW_ORIGINAL_DOWNLOADS=true
NEW_PHOTOS_REQUIRE_REVIEW=false
INDEX_ON_STARTUP=true

# Docker Compose: senha do PostgreSQL local
POSTGRES_PASSWORD=
