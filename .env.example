# Gere um token aleatório com pelo menos 32 caracteres. Não versione .env.
ADMIN_TOKEN=troque-por-um-token-aleatorio-longo

# Para uso local, deixe as origens locais. Em produção, defina a origem HTTPS exata.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

PHOTO_DIR=./frontend/images/gallery
DATA_DIR=./data
MODELS_DIR=./models

# A pontuação é similaridade, não probabilidade de identidade. Valide com fotos autorizadas.
FACE_MATCH_THRESHOLD=0.363
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=24000000
