# Copy this to .env.r2 and fill it in on your computer only.
# DO NOT commit .env.r2 to GitHub or share the secret key in chat.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=the-love-walk-fotos
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_PREFIX=the-love-walk-2026
# Optional if using the complete endpoint instead of R2_ACCOUNT_ID:
# R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
